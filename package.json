{
  "name": "ogame-future",
  "version": "0.3.44",
  "private": true,
  "description": "Future: userscript per la gestione e lo sviluppo dell'account OGame",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "node scripts/build.mjs && (node scripts/build.mjs --watch & node scripts/dev-browser.mjs)",
    "dev:reload": "node scripts/dev-browser.mjs reload",
    "dev:eval": "node scripts/dev-browser.mjs eval",
    "dev:goto": "node scripts/dev-browser.mjs goto",
    "dev:shot": "node scripts/dev-browser.mjs shot",
    "dev:tabs": "node scripts/dev-browser.mjs tabs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
